struct ReplTextField : LedDisplayTextField {
    Replhost* module;
    std::string lastText;
    ReplTextField() { multiline = true; color = nvgRGB(0, 255, 0); }
    void step() override {
        LedDisplayTextField::step();
        if (module && text != lastText) {
            module->compile(text); module->code = text; lastText = text;
        }
    }
    void draw(const DrawArgs& args) override {
        nvgBeginPath(args.vg);
        nvgRoundedRect(args.vg, 0, 0, box.size.x, box.size.y, 5.0f);
        nvgFillColor(args.vg, nvgRGB(20, 20, 20)); nvgFill(args.vg);
        LedDisplayTextField::draw(args);
    }
};

struct ReplhostPolyItem : MenuItem {
    Replhost* module;
    int channels;
    void onAction(const event::Action& e) override { module->polyChannels = channels; }
};

struct ReplhostWidget : ModuleWidget {
    ReplhostWidget(Replhost* module) {
        setModule(module);
        box.size = Vec(450, 380);

        struct PanelBg : TransparentWidget {
            void draw(const DrawArgs& args) override {
                nvgBeginPath(args.vg);
                nvgRect(args.vg, 0, 0, box.size.x, box.size.y);
                nvgFillColor(args.vg, nvgRGB(35, 35, 35)); nvgFill(args.vg);
            }
        };
        PanelBg* bg = new PanelBg();
        bg->box.size = box.size;
        addChild(bg);

        ReplTextField* editor = createWidget<ReplTextField>(Vec(80, 40));
        editor->box.size = Vec(310, 275);
        editor->module = module;
        if (module) { editor->text = module->code; editor->lastText = module->code; }
        addChild(editor);

        addInput(createInputCentered<PJ301MPort>(Vec(35, 45), module, Replhost::CLOCK_INPUT));
        addInput(createInputCentered<PJ301MPort>(Vec(35, 100), module, Replhost::RUN_INPUT));
        addParam(createParamCentered<LEDButton>(Vec(35, 135), module, Replhost::RUN_PARAM));
        addChild(createLightCentered<MediumLight<GreenLight>>(Vec(35, 135), module, Replhost::RUN_LIGHT));
        addInput(createInputCentered<PJ301MPort>(Vec(35, 190), module, Replhost::RESET_INPUT));
        addParam(createParamCentered<LEDButton>(Vec(35, 225), module, Replhost::RESET_PARAM));

        for (int i = 0; i < 8; i++) addOutput(createOutputCentered<PJ301MPort>(Vec(80 + i * 40, 355), module, Replhost::CV_OUTPUT + i));
        for (int i = 0; i < 8; i++) addOutput(createOutputCentered<PJ301MPort>(Vec(420, 70 + i * 33), module, Replhost::GATE_OUTPUT + i));
    }

    void appendContextMenu(Menu* menu) override {
        Replhost* module = dynamic_cast<Replhost*>(this->module);
        if (!module) return;
        menu->addChild(new MenuSeparator);
        menu->addChild(createMenuLabel("Polyphony Channels Max Limit"));
        for (int i = 1; i <= 16; i++) {
            ReplhostPolyItem* item = new ReplhostPolyItem;
            item->text = string::f("%d%s", i, (i == 1 ? " (Monophonic)" : ""));
            item->rightText = (module->polyChannels == i) ? "✔" : "";
            item->module = module;
            item->channels = i;
            menu->addChild(item);
        }
    }

    void drawLayer(const DrawArgs& args, int layer) override {
        if (layer == 1) {
            std::shared_ptr<Font> font = APP->window->uiFont;
            if (font) {
                nvgFontFaceId(args.vg, font->handle);
                nvgFillColor(args.vg, nvgRGB(220, 220, 220));
                nvgTextAlign(args.vg, NVG_ALIGN_CENTER | NVG_ALIGN_TOP);
                
