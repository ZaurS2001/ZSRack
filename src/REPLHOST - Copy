//=============================================================================
// STRUDEL AST (PATTERN ENGINE & EFFECTS)
//=============================================================================

struct Arc { double start, end; };
struct Hap { Arc whole, part; float value; bool isRest; };

// Base Pattern Interface
class Pattern {
public:
    virtual ~Pattern() = default;
    virtual std::vector<Hap> queryArc(Arc a) = 0;
    
    // Returns the structural polyphony requirement of the pattern
    virtual int getLayerCount() { return 1; }
};

class PatternValue : public Pattern {
    float val; bool isRest;
public:
    PatternValue(float v, bool r = false) : val(v), isRest(r) {}
    std::vector<Hap> queryArc(Arc a) override {
        std::vector<Hap> results;
        int minC = std::floor(a.start);
        int maxC = std::floor(a.end);
        for (int c = minC; c <= maxC; ++c) {
            double cs = c, ce = c + 1.0;
            double os = std::max(a.start, cs);
            double oe = std::min(a.end, ce);
            if (os < oe) results.push_back({{cs, ce}, {os, oe}, val, isRest});
        }
        return results;
    }
    int getLayerCount() override { return 1; }
};

class PatternSeq : public Pattern {
    std::vector<std::shared_ptr<Pattern>> steps;
public:
    PatternSeq(std::vector<std::shared_ptr<Pattern>> s) : steps(s) {}
    std::vector<Hap> queryArc(Arc a) override {
        std::vector<Hap> results;
        int n = steps.size();
        if (n == 0) return results;
        double stepLen = 1.0 / n;
        for (int c = std::floor(a.start); c <= std::floor(a.end); ++c) {
            for (int i = 0; i < n; ++i) {
                double stepStart = c + i * stepLen;
                double stepEnd = c + (i + 1) * stepLen;
                double os = std::max(a.start, stepStart);
                double oe = std::min(a.end, stepEnd);
                if (os < oe) {
                    Arc innerArc = { (os - stepStart) / stepLen, (oe - stepStart) / stepLen };
                    auto innerHaps = steps[i]->queryArc(innerArc);
                    for (auto& h : innerHaps) {
                        h.whole.start = stepStart + h.whole.start * stepLen;
                        h.whole.end = stepStart + h.whole.end * stepLen;
                        h.part.start = stepStart + h.part.start * stepLen;
                        h.part.end = stepStart + h.part.end * stepLen;
                        results.push_back(h);
                    }
                }
            }
        }
        return results;
    }
    int getLayerCount() override {
        int maxL = 1;
        for (auto& p : steps) maxL = std::max(maxL, p->getLayerCount());
        return maxL;
    }
};

class PatternStack : public Pattern {
    std::vector<std::shared_ptr<Pattern>> inners;
public:
    PatternStack(std::vector<std::shared_ptr<Pattern>> p) : inners(p) {}
    std::vector<Hap> queryArc(Arc a) override {
        std::vector<Hap> results;
        for (auto& p : inners) {
            auto haps = p->queryArc(a);
            results.insert(results.end(), haps.begin(), haps.end());
        }
        return results;
    }
    int getLayerCount() override {
        int sum = 0;
        for (auto& p : inners) sum += p->getLayerCount();
        return std::max(1, sum);
    }
};

// Modifiers (Maintain Inner Layer Count)
class PatternFast : public Pattern {
    std::shared_ptr<Pattern> inner; float factor;
public:
    PatternFast(std::shared_ptr<Pattern> p, float f) : inner(p), factor(f) {}
    std::vector<Hap> queryArc(Arc a) override {
        auto haps = inner->queryArc({a.start * factor, a.end * factor});
        for (auto& h : haps) {
            h.whole.start /= factor; h.whole.end /= factor;
            h.part.start /= factor; h.part.end /= factor;
        }
        return haps;
    }
    int getLayerCount() override { return inner->getLayerCount(); }
};

class PatternRev : public Pattern {
    std::shared_ptr<Pattern> inner;
public:
    PatternRev(std::shared_ptr<Pattern> p) : inner(p) {}
    std::vector<Hap> queryArc(Arc a) override {
        std::vector<Hap> results;
        for (int c = std::floor(a.start); c <= std::floor(a.end); ++c) {
            double cs = c, ce = c + 1.0;
            double os = std::max(a.start, cs), oe = std::min(a.end, ce);
            if (os < oe) {
                auto haps = inner->queryArc({cs + (1.0 - (oe - cs)), cs + (1.0 - (os - cs))});
                for (auto& h : haps) {
                    double ws = h.whole.start - cs, we = h.whole.end - cs;
                    h.whole.start = cs + (1.0 - we); h.whole.end = cs + (1.0 - ws);
                    double ps = h.part.start - cs, pe = h.part.end - cs;
                    h.part.start = cs + (1.0 - pe); h.part.end = cs + (1.0 - ps);
                    results.push_back(h);
                }
            }
        }
        return results;
    }
    int getLayerCount() override { return inner->getLayerCount(); }
};

class PatternAdd : public Pattern {
    std::shared_ptr<Pattern> inner; float addVal;
public:
    PatternAdd(std::shared_ptr<Pattern> p, float v) : inner(p), addVal(v) {}
    std::vector<Hap> queryArc(Arc a) override {
        auto haps = inner->queryArc(a);
        for (auto& h : haps) { if (!h.isRest) h.value += addVal; }
        return haps;
    }
    int getLayerCount() override { return inner->getLayerCount(); }
};

class PatternLate : public Pattern {
    std::shared_ptr<Pattern> inner; double shift;
public:
    PatternLate(std::shared_ptr<Pattern> p, double s) : inner(p), shift(s) {}
    std::vector<Hap> queryArc(Arc a) override {
        auto haps = inner->queryArc({a.start - shift, a.end - shift});
        for (auto& h : haps) {
            h.whole.start += shift; h.whole.end += shift;
            h.part.start += shift; h.part.end += shift;
        }
        return haps;
    }
    int getLayerCount() override { return inner->getLayerCount(); }
};

class PatternPly : public Pattern {
    std::shared_ptr<Pattern> inner; int n;
public:
    PatternPly(std::shared_ptr<Pattern> p, int _n) : inner(p), n(_n) {}
    std::vector<Hap> queryArc(Arc a) override {
        auto haps = inner->queryArc(a);
        std::vector<Hap> results;
        for (auto& h : haps) {
            double step = (h.part.end - h.part.start) / n;
            for (int i = 0; i < n; i++) {
                Hap sub = h;
                sub.part.start = h.part.start + i * step;
                sub.part.end = sub.part.start + step;
                sub.whole = sub.part;
                results.push_back(sub);
            }
        }
        return results;
    }
    int getLayerCount() override { return inner->getLayerCount(); }
};

//=============================================================================
// PARSER UTILS
//=============================================================================

std::vector<std::string> tokenize(std::string s) {
    std::vector<std::string> tokens;
    std::string current = "";
    for (size_t i = 0; i < s.length(); i++) {
        char c = s[i];
        if (std::isspace(c)) {
            if (!current.empty()) { tokens.push_back(current); current = ""; }
        } else if (c == '[' || c == ']' || c == ',') {
            if (!current.empty()) { tokens.push_back(current); current = ""; }
            tokens.push_back(std::string(1, c));
        } else if (c == '*' || c == '/') {
            if (!current.empty()) { tokens.push_back(current); current = ""; }
            current += c;
        } else current += c;
    }
    if (!current.empty()) tokens.push_back(current);
    return tokens;
}

std::shared_ptr<Pattern> parseValue(std::string t) {
    if (t == "~") return std::make_shared<PatternValue>(0, true);
    std::string lower = "";
    for (char c : t) lower += std::tolower(c);
    
    int note = 0; size_t i = 0;
    if (lower[i] == 'c') note = 0; else if (lower[i] == 'd') note = 2; else if (lower[i] == 'e') note = 4;
    else if (lower[i] == 'f') note = 5; else if (lower[i] == 'g') note = 7; else if (lower[i] == 'a') note = 9;
    else if (lower[i] == 'b') note = 11; else return std::make_shared<PatternValue>(0.0f, false);
    
    i++;
    if (i < lower.size() && (lower[i] == '#' || lower[i] == 's')) { note++; i++; }
    else if (i < lower.size() && lower[i] == 'b') { note--; i++; }
    
    int oct = 4;
    if (i < lower.size() && std::isdigit(lower[i])) {
        oct = lower[i] - '0';
        if (i + 1 < lower.size() && std::isdigit(lower[i+1])) oct = oct * 10 + (lower[i+1] - '0');
    }
    float cv = ((oct * 12 + note + 12) - 60) / 12.0f;
    return std::make_shared<PatternValue>(cv, false);
}

std::shared_ptr<Pattern> parseGroup(const std::vector<std::string>& tokens, size_t& pos) {
    std::vector<std::shared_ptr<Pattern>> layers;
    std::vector<std::shared_ptr<Pattern>> currentSeq;
    
    while (pos < tokens.size()) {
        std::string t = tokens[pos];
        if (t == "]") {
            pos++; break;
        } else if (t == ",") {
            if (currentSeq.size() == 1) layers.push_back(currentSeq[0]);
            else layers.push_back(std::make_shared<PatternSeq>(currentSeq));
            currentSeq.clear(); pos++;
        } else {
            std::shared_ptr<Pattern> p;
            if (t == "[") {
                pos++; p = parseGroup(tokens, pos);
            } else { p = parseValue(t); pos++; }
            
            while (pos < tokens.size() && (tokens[pos][0] == '*' || tokens[pos][0] == '/')) {
                std::string mod = tokens[pos++];
                try {
                    float factor = std::stof(mod.substr(1));
                    if (mod[0] == '*') p = std::make_shared<PatternFast>(p, factor);
                    else p = std::make_shared<PatternFast>(p, 1.0f / factor);
                } catch(...) {}
            }
            currentSeq.push_back(p);
        }
    }
    std::shared_ptr<Pattern> seqPat = (currentSeq.size() == 1) ? currentSeq[0] : std::make_shared<PatternSeq>(currentSeq);
    if (layers.empty()) return seqPat;
    layers.push_back(seqPat);
    return std::make_shared<PatternStack>(layers);
}

//=============================================================================
// POLYPHONIC ALLOCATOR
//=============================================================================

struct VoiceAllocator {
    float timers[16] = {0.f};
    float cvs[16] = {0.f};

    int allocate(int numChannels, float cv, float gateDur) {
        int bestVoice = 0;
        float minTimer = 1e9f;
        
        for (int i = 0; i < numChannels; i++) {
            if (timers[i] <= 0.0f) { // Found completely free voice
                cvs[i] = cv;
                timers[i] = gateDur;
                return i;
            }
            if (timers[i] < minTimer) {
                minTimer = timers[i];
                bestVoice = i;
            }
        }
        // Steal the voice that finishes earliest if all are fully occupied
        cvs[bestVoice] = cv;
        timers[bestVoice] = gateDur;
        return bestVoice;
    }

    void process(float dt) {
        for (int i = 0; i < 16; i++) {
            if (timers[i] > 0.0f) {
                timers[i] -= dt;
                if (timers[i] < 0.0f) timers[i] = 0.0f;
            }
        }
    }
};

//=============================================================================
// MODULE
//=============================================================================

struct ScheduledEvent { double time; double length; float value; bool isRest; };

struct Replhost : Module {
    enum ParamIds { RUN_PARAM, RESET_PARAM, NUM_PARAMS };
    enum InputIds { CLOCK_INPUT, RUN_INPUT, RESET_INPUT, NUM_INPUTS };
    enum OutputIds { ENUMS(CV_OUTPUT, 8), ENUMS(GATE_OUTPUT, 8), NUM_OUTPUTS };
    enum LightIds { RUN_LIGHT, NUM_LIGHTS };

    std::string code = "CH1 = n(\"c4[e4 g4]*2\").ply(2)\nCH2 = n(\"bd ~ ~ bd\").off(0.125, 'rev')";
    
    std::shared_ptr<Pattern> activePatterns[8];
    std::vector<ScheduledEvent> eventQueue[8];
    VoiceAllocator voices[8];

    dsp::SchmittTrigger clockTrigger, runBtnTrigger, runCvTrigger;
    dsp::BooleanTrigger resetTrigger;

    bool isRunning = true;
    int polyChannels = 16; // Polyphony Max Limit (Dynamic bound natively via AST)
    double cycleTime = 0.0;
    double lastQueryTime = 0.0;
    double queryInterval = 0.1;
    float bpm = 120.0f;
    int samplesSinceLastClock = 0;

    Replhost() {
        config(NUM_PARAMS, NUM_INPUTS, NUM_OUTPUTS, NUM_LIGHTS);
        configInput(CLOCK_INPUT, "External Clock");
        configInput(RUN_INPUT, "Run Toggle CV");
        configInput(RESET_INPUT, "Reset CV");
        configParam(RUN_PARAM, 0.f, 1.f, 0.f, "Run Toggle");
        configParam(RESET_PARAM, 0.f, 1.f, 0.f, "Reset Trigger");
        
        for (int i = 0; i < 8; ++i) {
            configOutput(CV_OUTPUT + i, string::f("CH%d Poly CV", i + 1));
            configOutput(GATE_OUTPUT + i, string::f("CH%d Poly Gate", i + 1));
        }
        compile(code);
    }

    std::shared_ptr<Pattern> parseLine(std::string line) {
        size_t start = line.find("(\"");
        if (start == std::string::npos) return nullptr;
        size_t end = line.find("\")", start);
        if (end == std::string::npos) return nullptr;
        
        auto tokens = tokenize(line.substr(start + 2, end - start - 2));
        size_t pos = 0;
        auto p = parseGroup(tokens, pos);
        
        size_t curr = end + 2;
        while (curr < line.size()) {
            size_t dot = line.find(".", curr);
            if (dot == std::string::npos) break;
            size_t openParen = line.find("(", dot);
            if (openParen == std::string::npos) break;
            size_t closeParen = line.find(")", openParen);
            if (closeParen == std::string::npos) break;
            
            std::string method = line.substr(dot + 1, openParen - dot - 1);
            std::string argStr = line.substr(openParen + 1, closeParen - openParen - 1);
            
            if (method == "fast") { try { p = std::make_shared<PatternFast>(p, std::stof(argStr)); } catch(...) {} }
            else if (method == "slow") { try { p = std::make_shared<PatternFast>(p, 1.0f / std::stof(argStr)); } catch(...) {} }
            else if (method == "rev") { p = std::make_shared<PatternRev>(p); }
            else if (method == "add") { try { p = std::make_shared<PatternAdd>(p, std::stof(argStr) / 12.0f); } catch(...) {} }
            else if (method == "ply") { try { p = std::make_shared<PatternPly>(p, std::stoi(argStr)); } catch(...) {} }
            else if (method == "late") { try { p = std::make_shared<PatternLate>(p, std::stof(argStr)); } catch(...) {} }
            else if (method == "early") { try { p = std::make_shared<PatternLate>(p, -std::stof(argStr)); } catch(...) {} }
            else if (method == "jux") {
                std::string mod = argStr;
                mod.erase(std::remove(mod.begin(), mod.end(), '\''), mod.end());
                if (mod == "rev") p = std::make_shared<PatternStack>(std::vector<std::shared_ptr<Pattern>>{p, std::make_shared<PatternRev>(p)});
            }
            else if (method == "off") {
                size_t comma = argStr.find(",");
                if (comma != std::string::npos) {
                    try {
                        float shift = std::stof(argStr.substr(0, comma));
                        std::string mod = argStr.substr(comma + 1);
                        mod.erase(std::remove(mod.begin(), mod.end(), ' '), mod.end());
                        mod.erase(std::remove(mod.begin(), mod.end(), '\''), mod.end());
                        
                        std::shared_ptr<Pattern> modded = p;
                        if (mod.find("add(") == 0) {
                            float val = std::stof(mod.substr(4, mod.size() - 5));
                            modded = std::make_shared<PatternAdd>(modded, val / 12.0f);
                        } else if (mod == "rev") {
                            modded = std::make_shared<PatternRev>(modded);
                        }
                        modded = std::make_shared<PatternLate>(modded, shift);
                        p = std::make_shared<PatternStack>(std::vector<std::shared_ptr<Pattern>>{p, modded});
                    } catch(...) {}
                }
            }
            curr = closeParen + 1;
        }
        return p;
    }

    void compile(const std::string& newCode) {
        for (int i = 0; i < 8; i++) { activePatterns[i] = nullptr; eventQueue[i].clear(); }
        std::istringstream stream(newCode);
        std::string line;
        while (std::getline(stream, line)) {
            for (int i = 0; i < 8; i++) {
                if (line.find("CH" + std::to_string(i + 1)) != std::string::npos) activePatterns[i] = parseLine(line);
            }
        }
        lastQueryTime = cycleTime;
    }

    void process(const ProcessArgs& args) override {
        if (resetTrigger.process(params[RESET_PARAM].getValue() + inputs[RESET_INPUT].getVoltage())) {
            cycleTime = 0.0; lastQueryTime = 0.0;
            for (int i=0; i<8; ++i) eventQueue[i].clear();
        }
        if (runBtnTrigger.process(params[RUN_PARAM].getValue())) isRunning = !isRunning;
        if (runCvTrigger.process(inputs[RUN_INPUT].getVoltage())) isRunning = !isRunning;
        
        lights[RUN_LIGHT].setBrightness(isRunning ? 1.0f : 0.0f);

        if (inputs[CLOCK_INPUT].isConnected()) {
            if (clockTrigger.process(inputs[CLOCK_INPUT].getVoltage())) {
                if (samplesSinceLastClock > 0) bpm = (args.sampleRate / samplesSinceLastClock) * 60.0f;
                samplesSinceLastClock = 0;
            }
            samplesSinceLastClock++;
        }

        float cps = (std::max(1.0f, bpm) / 60.0f) / 4.0f;
        
        if (isRunning) {
            cycleTime += cps / args.sampleRate;

            if (cycleTime >= lastQueryTime) {
                double queryEnd = lastQueryTime + queryInterval;
                for (int i = 0; i < 8; ++i) {
                    if (activePatterns[i]) {
                        auto haps = activePatterns[i]->queryArc({lastQueryTime, queryEnd});
                        for (auto& h : haps) {
                            if (h.whole.start >= lastQueryTime && h.whole.start < queryEnd) {
                                eventQueue[i].push_back({h.whole.start, h.whole.end - h.whole.start, h.value, h.isRest});
                            }
                        }
                        std::sort(eventQueue[i].begin(), eventQueue[i].end(),[](const ScheduledEvent& a, const ScheduledEvent& b) { return a.time < b.time; });
                    }
                }
                lastQueryTime = queryEnd;
            }
        }

        // Voice Allocator Updates
        for (int i = 0; i < 8; i++) voices[i].process(args.sampleTime);

        for (int i = 0; i < 8; ++i) {
            // Clever Split: Extract exact AST polyphony requirement (Commans, jux, stacks)
            int activeChannels = 1;
            if (activePatterns[i]) {
                activeChannels = activePatterns[i]->getLayerCount();
                // Bound it strictly by the user's right-click Menu Max Polyphony setting
                activeChannels = std::max(1, std::min(activeChannels, polyChannels));
            }

            if (isRunning) {
                for (auto it = eventQueue[i].begin(); it != eventQueue[i].end(); ) {
                    if (cycleTime >= it->time) {
                        if (!it->isRest) {
                            // Gate timer spans 50% of the pattern step duration in seconds
                            float durSeconds = std::max(0.01f, (float)(it->length * (60.0f / std::max(1.0f, bpm)) * 4.0f * 0.5f));
                            voices[i].allocate(activeChannels, it->value, durSeconds);
                        }
                        it = eventQueue[i].erase(it);
                    } else ++it;
                }
            }
            
            // Set exact required channels. Ensures no 0V drone copying happens on downstream Poly VCOs.
            outputs[CV_OUTPUT + i].setChannels(activeChannels);
            outputs[GATE_OUTPUT + i].setChannels(activeChannels);
            
            for (int c = 0; c < activeChannels; c++) {
                outputs[CV_OUTPUT + i].setVoltage(voices[i].cvs[c], c);
                outputs[GATE_OUTPUT + i].setVoltage(voices[i].timers[c] > 0.0f ? 10.0f : 0.0f, c);
            }
        }
    }

    json_t* dataToJson() override {
        json_t* rootJ = json_object();
        json_object_set_new(rootJ, "code", json_string(code.c_str()));
        json_object_set_new(rootJ, "poly", json_integer(polyChannels));
        return rootJ;
    }
    void dataFromJson(json_t* rootJ) override {
        json_t* cJ = json_object_get(rootJ, "code");
        if (cJ) code = json_string_value(cJ);
        json_t* pJ = json_object_get(rootJ, "poly");
        if (pJ) polyChannels = json_integer_value(pJ);
        compile(code);
    }
};

